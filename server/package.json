{
  "name": "careerlaunch-server",
  "version": "1.0.0",
  "description": "CareerLaunch Node.js + Express + MongoDB Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:start": "mongod --config C:\\data\\careerlaunch\\mongod.cfg",
    "check": "powershell -ExecutionPolicy Bypass -File ../scripts/check-careerlaunch.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File ../scripts/stop-careerlaunch.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "mongoose": "^8.9.5"
  }
}
